<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>متجر الأواني والضيافة - المنصة المتكاملة</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-body: #fdfbf7;
            --card-bg: #ffffff;
            --primary-beige: #f5efe6;
            --accent-gold: #c59b27;
            --text-dark: #2c2a29;
            --text-muted: #78716c;
            --border-color: #e7e5e4;
            --danger: #ef4444;
            --success: #10b981;
            --whatsapp: #25d366;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: var(--bg-body); color: var(--text-dark); padding-bottom: 60px; }

        header { background: var(--card-bg); border-bottom: 1px solid var(--border-color); padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; }
        .header-right, .header-left { display: flex; align-items: center; gap: 12px; }
        
        .header-icon-btn { background: var(--primary-beige); border: 1px solid var(--border-color); color: var(--text-dark); width: 36px; height: 36px; border-radius: 50%; font-size: 0.9rem; cursor: pointer; position: relative; display: flex; align-items: center; justify-content: center; }
        .header-icon-btn:hover { background: var(--accent-gold); color: white; border-color: var(--accent-gold); }
        .cart-badge, .wish-badge { position: absolute; top: -4px; right: -4px; background: var(--accent-gold); color: white; font-size: 0.65rem; border-radius: 50%; padding: 2px 5px; font-weight: bold; }

        .store-logo { font-size: 1.1rem; color: var(--text-dark); font-weight: 800; text-decoration: none; cursor: pointer; }

        .search-container { max-width: 1000px; margin: 15px auto 0 auto; padding: 0 15px; display: none; }
        .search-container.active { display: block; }
        .search-input { width: 100%; padding: 12px 16px; border: 1px solid var(--border-color); border-radius: 25px; outline: none; background: white; font-size: 0.9rem; }

        .container { max-width: 1000px; margin: 10px auto; padding: 0 15px; }
        .section-title { font-size: 1.1rem; font-weight: 800; margin: 25px 0 15px 0; color: var(--text-dark); border-right: 4px solid var(--accent-gold); padding-right: 10px; display: flex; justify-content: space-between; align-items: center; }
        .view-all-btn { font-size: 0.8rem; color: var(--accent-gold); cursor: pointer; text-decoration: underline; }

        .products-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
        @media(min-width: 768px) { .products-grid { grid-template-columns: repeat(4, 1fr); gap: 20px; } }

        .product-card { background: var(--card-bg); border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color); display: flex; flex-direction: column; justify-content: space-between; position: relative; }
        .product-img { width: 100%; height: 150px; object-fit: cover; background: #fafaf9; }
        .product-info { padding: 10px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
        .product-title { font-size: 0.85rem; font-weight: 700; margin-bottom: 4px; line-height: 1.3; }
        .stock-badge { font-size: 0.7rem; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; }
        .rating { color: var(--accent-gold); font-size: 0.75rem; margin-bottom: 6px; cursor: pointer; }
        .product-price { font-size: 0.95rem; font-weight: 800; color: var(--accent-gold); margin-bottom: 8px; }
        
        .card-actions { display: flex; gap: 6px; }
        .add-cart-btn { flex: 1; background: var(--primary-beige); color: var(--text-dark); border: 1px solid var(--border-color); padding: 8px; border-radius: 8px; font-weight: 700; font-size: 0.8rem; cursor: pointer; text-align: center; }
        .add-cart-btn:hover { background: var(--accent-gold); color: white; }
        .add-cart-btn:disabled { background: #e5e5e5; color: #a1a1aa; cursor: not-allowed; }
        .wishlist-btn { background: white; border: 1px solid var(--border-color); padding: 8px 10px; border-radius: 8px; cursor: pointer; color: var(--text-muted); }
        .wishlist-btn.active { color: var(--danger); border-color: var(--danger); }

        .modal { display: none; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:300; justify-content:center; align-items:center; padding:15px; }
        .modal-content { background:white; border-radius:16px; padding:20px; width:100%; max-width:480px; max-height:90vh; overflow-y:auto; border: 1px solid var(--border-color); }
        .close-btn { background:none; border:none; font-size:1.2rem; cursor:pointer; color: var(--text-muted); }

        .user-menu-item { display: flex; align-items: center; gap: 10px; padding: 10px 8px; border-bottom: 1px solid var(--border-color); color: var(--text-dark); text-decoration: none; font-size: 0.85rem; cursor: pointer; }
        .user-menu-item:hover { background: var(--primary-beige); border-radius: 6px; }
        .user-menu-item i { width: 20px; color: var(--text-muted); }

        .auth-box { text-align: center; }
        .auth-avatar { width: 60px; height: 60px; border-radius: 50%; background: var(--primary-beige); display: flex; align-items: center; justify-content: center; margin: 0 auto 15px auto; font-size: 1.5rem; color: var(--accent-gold); border: 1px solid var(--border-color); }
        
        .form-group { margin-bottom: 12px; text-align: right; }
        .form-group label { display: block; font-size: 0.8rem; margin-bottom: 4px; font-weight: 600; color: var(--text-muted); }
        .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 8px; outline: none; background: white; font-size: 0.85rem; }

        .card-box { background: #fafaf9; border: 1px solid var(--border-color); border-radius: 10px; padding: 12px; margin-bottom: 12px; }
        .status-tag { display: inline-block; padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: bold; background: #e0f2fe; color: #0369a1; }
        
        .admin-section { background: #1e1e1e; color: white; padding: 15px; border-radius: 12px; margin-top: 15px; }
        .admin-section input, .admin-section select { background: #2a2a2a; color: white; border: 1px solid #3d3d3d; }
        .admin-prod-item { background: #2a2a2a; padding: 10px; border-radius: 6px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; }

        .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 15px; }
        .stat-card { background: #2a2a2a; padding: 12px; border-radius: 8px; text-align: center; }
        .stat-num { font-size: 1.2rem; font-weight: bold; color: var(--accent-gold); margin-top: 4px; }

        .shipping-progress-bg { background: #e7e5e4; border-radius: 10px; height: 10px; overflow: hidden; margin: 8px 0; }
        .shipping-progress-fill { background: var(--success); height: 100%; width: 0%; transition: width 0.3s; }

        .side-menu { display: none; position: fixed; top:0; right:0; width:80%; max-width:300px; height:100%; background: #ffffff; z-index:400; border-left: 1px solid var(--border-color); padding: 20px; box-shadow: -5px 0 15px rgba(0,0,0,0.1); }
        .side-menu-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid var(--border-color); }
        .side-menu-item { padding: 12px 0; border-bottom: 1px solid var(--border-color); color: var(--text-dark); font-size: 0.9rem; cursor: pointer; display: flex; justify-content: space-between; }

        @media print {
            body * { visibility: hidden; }
            #printableInvoice, #printableInvoice * { visibility: visible; }
            #printableInvoice { position: absolute; left: 0; top: 0; width: 100%; padding: 20px; background: white; color: black; }
        }
    </style>
</head>
<body>

    <!-- الهيدر العلوي -->
    <header>
        <div class="header-right">
            <button class="header-icon-btn" onclick="toggleSideMenu()"><i class="fa-solid fa-bars"></i></button>
        </div>

        <h1 class="store-logo" onclick="resetCategoryView()">متجر الأواني والضيافة</h1>

        <div class="header-left">
            <button class="header-icon-btn" onclick="toggleSearch()"><i class="fa-solid fa-magnifying-glass"></i></button>
            <button class="header-icon-btn" onclick="openWishlistModal()" title="المفضلة"><i class="fa-regular fa-heart"></i><span class="wish-badge" id="wishCount">0</span></button>
            <button class="header-icon-btn" onclick="openProfileModal()"><i class="fa-regular fa-user"></i></button>
            <button class="header-icon-btn" onclick="openCart()">
                <i class="fa-solid fa-bag-shopping"></i>
                <span class="cart-badge" id="cartCount">0</span>
            </button>
        </div>
    </header>

    <!-- القائمة الجانبية للأقسام -->
    <div class="side-menu" id="sideMenu">
        <div class="side-menu-header">
            <h4>القائمة الرئيسية</h4>
            <button class="close-btn" onclick="toggleSideMenu()">✕</button>
        </div>
        <div class="side-menu-item" onclick="filterByCategory('cups'); toggleSideMenu();">الفناجيل والدلات <span><i class="fa-solid fa-chevron-left" style="font-size:0.7rem;"></i></span></div>
        <div class="side-menu-item" onclick="filterByCategory('plates'); toggleSideMenu();">القدور والصحون <span><i class="fa-solid fa-chevron-left" style="font-size:0.7rem;"></i></span></div>
        <div class="side-menu-item" onclick="filterByCategory('best'); toggleSideMenu();">الأكثر مبيعاً <span><i class="fa-solid fa-chevron-left" style="font-size:0.7rem;"></i></span></div>
        <div class="side-menu-item" onclick="resetCategoryView(); toggleSideMenu();">جميع المنتجات <span><i class="fa-solid fa-chevron-left" style="font-size:0.7rem;"></i></span></div>
    </div>

    <!-- شريط البحث -->
    <div class="search-container" id="searchContainer">
        <input type="text" class="search-input" id="searchInput" placeholder="ابحث عن دلال، فناجيل، قدور..." onkeyup="filterProducts(this.value)">
    </div>

    <!-- محتوى المتجر -->
    <div class="container" id="mainContainer">
        <div id="homeSectionsView">
            <div class="section-title">
                الأكثر مبيعاً 
                <span class="view-all-btn" onclick="filterByCategory('best')">عرض الكل</span>
            </div>
            <div class="products-grid" id="bestGrid"></div>

            <div class="section-title">
                الفناجيل، الدلات والكاسات 
                <span class="view-all-btn" onclick="filterByCategory('cups')">عرض الكل</span>
            </div>
            <div class="products-grid" id="cupsGrid"></div>

            <div class="section-title">
                القدور والصحون 
                <span class="view-all-btn" onclick="filterByCategory('plates')">عرض الكل</span>
            </div>
            <div class="products-grid" id="platesGrid"></div>
        </div>

        <div id="singleCategoryView" style="display:none;">
            <div style="display:flex; align-items:center; gap:10px; margin: 15px 0;">
                <button onclick="resetCategoryView()" style="padding:6px 12px; background:var(--primary-beige); border:1px solid var(--border-color); border-radius:6px; cursor:pointer;"><i class="fa-solid fa-arrow-right"></i> الرجوع للرئيسية</button>
                <h2 id="currentCategoryTitle" style="font-size:1.2rem; font-weight:bold;"></h2>
            </div>
            <div class="products-grid" id="singleCategoryGrid"></div>
        </div>
    </div>

    <!-- نافذة السلة والدفع -->
    <div class="modal" id="cartModal">
        <div class="modal-content">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                <h3>سلة الشراء</h3>
                <button class="close-btn" onclick="closeModal('cartModal')">✕</button>
            </div>

            <div id="freeShippingContainer" style="background:#f0fdf4; padding:10px; border-radius:8px; margin-bottom:12px; font-size:0.8rem; text-align:center;">
                <div id="shippingText">أضف منتجات للحصول على شحن مجاني</div>
                <div class="shipping-progress-bg">
                    <div class="shipping-progress-fill" id="shippingProgress"></div>
                </div>
            </div>

            <div id="cartItems"></div>
            
            <div style="margin: 15px 0; display:flex; gap:8px;">
                <input type="text" id="couponInput" placeholder="أدخل كوبون الخصم" style="flex:1; padding:8px; border:1px solid var(--border-color); border-radius:6px; font-size:0.8rem;">
                <button onclick="applyCoupon()" style="padding:8px 12px; background:var(--text-dark); color:white; border:none; border-radius:6px; font-size:0.8rem; cursor:pointer;">تطبيق</button>
            </div>

            <div class="form-group">
                <label>طريقة الدفع</label>
                <select id="paymentMethod">
                    <option value="الدفع عند الاستلام">الدفع عند الاستلام 💵</option>
                    <option value="تحويل بنكي">تحويل بنكي 🏦</option>
                </select>
            </div>

            <div style="margin-top:15px; font-weight:bold; display:flex; justify-content:space-between;">
                <span>المجموع النهائي:</span><span id="cartTotal">0 درهم</span>
            </div>
            
            <button class="add-cart-btn" style="background:var(--accent-gold); color:white; margin-top:15px; width:100%;" onclick="checkout()">تأكيد الطلب</button>
            <button class="add-cart-btn" style="background:var(--whatsapp); color:white; margin-top:8px; width:100%;" onclick="checkoutWhatsapp()"><i class="fa-brands fa-whatsapp"></i> اطلب عبر واتساب مباشرة</button>
        </div>
    </div>

    <!-- نافذة قائمة الأمنيات (المفضلة) -->
    <div class="modal" id="wishlistModal">
        <div class="modal-content">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                <h3>قائمة الأمنيات (المفضلة) ❤️</h3>
                <button class="close-btn" onclick="closeModal('wishlistModal')">✕</button>
            </div>
            <div id="wishlistItemsContainer"></div>
        </div>
    </div>

    <!-- نافذة الحساب وتسجيل الدخول -->
    <div class="modal" id="profileModal">
        <div class="modal-content" id="profileModalContent"></div>
    </div>

    <!-- نافذة التقييم -->
    <div class="modal" id="reviewModal">
        <div class="modal-content">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                <h3>تقييم المنتج والتعليقات</h3>
                <button class="close-btn" onclick="closeModal('reviewModal')">✕</button>
            </div>
            <div id="reviewList" style="max-height:150px; overflow-y:auto; margin-bottom:12px;"></div>
            <form onsubmit="addReview(event)">
                <input type="hidden" id="reviewProdId">
                <div class="form-group">
                    <label>التقييم بالنجوم</label>
                    <select id="reviewStars">
                        <option value="5">⭐⭐⭐⭐⭐ (5/5)</option>
                        <option value="4">⭐⭐⭐⭐ (4/5)</option>
                        <option value="3">⭐⭐⭐ (3/5)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>رأيك بالمنتج</label>
                    <input type="text" id="reviewComment" placeholder="اكتب رأيك هنا..." required>
                </div>
                <button type="submit" class="add-cart-btn" style="background:var(--accent-gold); color:white; width:100%;">حفظ التقييم</button>
            </form>
        </div>
    </div>

    <div id="printableInvoice" style="display:none;"></div>

    <script>
        let cart = [];
        let wishlist = JSON.parse(localStorage.getItem('store_wishlist')) || [];
        let currentUser = JSON.parse(localStorage.getItem('current_user')) || null;
        let discountRate = 0;
        let activeCategory = null;

        const STORE_EMAIL = "Storesaifsaiff@gmail.com";
        const ADMIN_EMAIL = "syfb3144@gmail.com";
        const ADMIN_PASS = "Sayofii10pP";

        const initialProducts = [
            { id: 1, name: "طقم دلال ذهبي فاخر", category: "best", price: 320, stock: 5, img: "https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?w=500" },
            { id: 2, name: "فناجيل قهوة شفافة", category: "cups", price: 85, stock: 12, img: "https://images.unsplash.com/photo-1517256064527-09c73fc73e38?w=500" },
            { id: 3, name: "قدر ضغط ستانلس ستيل", category: "plates", price: 210, stock: 8, img: "https://images.unsplash.com/photo-1584990347426-c785bc675703?w=500" }
        ];

        const initialCoupons = [{ code: "OFF10", percent: 10, active: true }];

        function getProducts() { return JSON.parse(localStorage.getItem('store_products')) || initialProducts; }
        function getUsers() { return JSON.parse(localStorage.getItem('store_users')) || []; }
        function getOrders() { return JSON.parse(localStorage.getItem('store_orders')) || []; }
        function getCoupons() { return JSON.parse(localStorage.getItem('store_coupons')) || initialCoupons; }
        function getReviews() { return JSON.parse(localStorage.getItem('store_reviews')) || {}; }
        function getFreeShippingMin() { return Number(localStorage.getItem('free_shipping_min')) || 300; }
        function generateOrderNumber() { return "ORD-" + Math.floor(10000 + Math.random() * 90000); }

        function renderStore(filterQuery = "") {
            const products = getProducts();
            document.getElementById('wishCount').innerText = wishlist.length;

            if (activeCategory) {
                document.getElementById('homeSectionsView').style.display = 'none';
                document.getElementById('singleCategoryView').style.display = 'block';
                
                const catNames = { 'best': 'الأكثر مبيعاً', 'cups': 'الفناجيل والدلات', 'plates': 'القدور والصحون' };
                document.getElementById('currentCategoryTitle').innerText = catNames[activeCategory] || 'القسم';

                const grid = document.getElementById('singleCategoryGrid');
                grid.innerHTML = '';
                const filtered = products.filter(p => p.category === activeCategory && p.name.includes(filterQuery));
                
                filtered.forEach(p => {
                    grid.innerHTML += createProductCardHTML(p);
                });
            } else {
                document.getElementById('homeSectionsView').style.display = 'block';
                document.getElementById('singleCategoryView').style.display = 'none';

                ['best', 'cups', 'plates'].forEach(cat => {
                    const grid = document.getElementById(cat + 'Grid');
                    if(!grid) return;
                    grid.innerHTML = '';
                    
                    const filtered = products.filter(p => p.category === cat && p.name.includes(filterQuery));
                    filtered.forEach(p => {
                        grid.innerHTML += createProductCardHTML(p);
                    });
                });
            }
        }

        function createProductCardHTML(p) {
            const isOutOfStock = p.stock <= 0;
            const isWish = wishlist.some(item => item.id === p.id);
            return `
                <div class="product-card">
                    <img src="${p.img}" class="product-img">
                    <div class="product-info">
                        <div>
                            <div class="product-title">${p.name}</div>
                            <div class="stock-badge">${isOutOfStock ? '<span style="color:var(--danger)">نفدت الكمية ❌</span>' : 'المتبقي: ' + p.stock + ' قطعة'}</div>
                            <div class="rating" onclick="openReviewModal(${p.id})"><i class="fa-solid fa-star"></i> التقييمات والآراء</div>
                        </div>
                        <div>
                            <div class="product-price">${p.price} درهم</div>
                            <div class="card-actions">
                                <button class="add-cart-btn" ${isOutOfStock ? 'disabled' : ''} onclick="addToCart(${p.id})">
                                    ${isOutOfStock ? 'غير متوفر' : 'إضافة للسلة'}
                                </button>
                                <button class="wishlist-btn ${isWish ? 'active' : ''}" onclick="toggleWishlist(${p.id})">
                                    <i class="${isWish ? 'fa-solid' : 'fa-regular'} fa-heart"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>`;
        }

        function toggleWishlist(id) {
            const products = getProducts();
            const p = products.find(item => item.id === id);
            const index = wishlist.findIndex(item => item.id === id);

            if (index > -1) {
                wishlist.splice(index, 1);
            } else {
                wishlist.push(p);
            }
            localStorage.setItem('store_wishlist', JSON.stringify(wishlist));
            renderStore();
        }

        function openWishlistModal() {
            const container = document.getElementById('wishlistItemsContainer');
            container.innerHTML = wishlist.length ? '' : '<small>قائمة الأمنيات فارغة حالياً</small>';
            wishlist.forEach(p => {
                container.innerHTML += `
                    <div style="display:flex; justify-content:space-between; align-items:center; background:#fafaf9; padding:8px; border-radius:8px; margin-bottom:8px;">
                        <span>${p.name} (${p.price} درهم)</span>
                        <button onclick="addToCart(${p.id}); closeModal('wishlistModal'); openCart();" style="background:var(--accent-gold); color:white; border:none; padding:6px 10px; border-radius:6px; cursor:pointer;">إضافة للسلة</button>
                    </div>`;
            });
            document.getElementById('wishlistModal').style.display = 'flex';
        }

        function filterByCategory(cat) {
            activeCategory = cat;
            renderStore();
        }

        function resetCategoryView() {
            activeCategory = null;
            renderStore();
        }

        function toggleSideMenu() {
            const menu = document.getElementById('sideMenu');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleSearch() {
            const search = document.getElementById('searchContainer');
            search.classList.toggle('active');
        }

        function filterProducts(query) {
            renderStore(query);
        }

        function openReviewModal(prodId) {
            document.getElementById('reviewProdId').value = prodId;
            const reviews = getReviews()[prodId] || [];
            const container = document.getElementById('reviewList');
            container.innerHTML = reviews.length ? '' : '<small>لا توجد تقييمات بعد</small>';
            reviews.forEach(r => {
                container.innerHTML += `<div style="background:#f5f5f5; padding:6px; border-radius:6px; margin-bottom:4px; font-size:0.8rem;"><b>${'⭐'.repeat(r.stars)}</b>: ${r.comment}</div>`;
            });
            document.getElementById('reviewModal').style.display = 'flex';
        }

        function addReview(e) {
            e.preventDefault();
            const prodId = document.getElementById('reviewProdId').value;
            const stars = document.getElementById('reviewStars').value;
            const comment = document.getElementById('reviewComment').value;

            let reviews = getReviews();
            if(!reviews[prodId]) reviews[prodId] = [];
            reviews[prodId].push({ stars, comment });

            localStorage.setItem('store_reviews', JSON.stringify(reviews));
            alert('شكراً لتقييمك!');
            closeModal('reviewModal');
        }

        function openProfileModal() {
            const container = document.getElementById('profileModalContent');
            
            if(!currentUser) {
                container.innerHTML = `
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                        <h3>تسجيل الدخول</h3>
                        <button class="close-btn" onclick="closeModal('profileModal')">✕</button>
                    </div>
                    <div class="auth-box">
                        <div class="auth-avatar"><i class="fa-regular fa-user"></i></div>
                        <form onsubmit="login(event)">
                            <div class="form-group">
                                <label>البريد الإلكتروني</label>
                                <input type="email" id="logEmail" placeholder="your@email.com" required>
                            </div>
                            <div class="form-group">
                                <label>كلمة المرور</label>
                                <input type="password" id="logPass" placeholder="••••••••" required>
                            </div>
                            <button type="submit" class="add-cart-btn" style="background:var(--accent-gold); color:white; font-weight:bold; padding:12px; margin-top:10px; width:100%;">دخول</button>
                        </form>
                    </div>
                `;
            } else {
                let html = `
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                        <h3>حسابي</h3>
                        <button class="close-btn" onclick="closeModal('profileModal')">✕</button>
                    </div>
                    <div class="card-box">
                        <p><b>الاسم:</b> ${currentUser.name}</p>
                        <p><b>البريد:</b> ${currentUser.email}</p>
                        <button class="add-cart-btn" style="margin-top:10px; background:var(--danger); color:white; width:100%;" onclick="logout()">تسجيل الخروج</button>
                    </div>
                    <h4>📦 طلباتي السابقة</h4>
                    <div id="myOrdersList" style="margin-top:8px;"></div>
                `;

                if(currentUser.role === 'admin') {
                    const orders = getOrders();
                    const totalSales = orders.reduce((acc, o) => acc + parseFloat(o.total), 0);
                    html += `
                        <div class="admin-section">
                            <h3 style="color:var(--accent-gold); margin-bottom:10px;">📊 لوحة تحكم المدير والإحصائيات</h3>
                            <div class="stats-grid">
                                <div class="stat-card"><div>إجمالي المبيعات</div><div class="stat-num">${totalSales} د.إ</div></div>
                                <div class="stat-card"><div>عدد الطلبات</div><div class="stat-num">${orders.length}</div></div>
                            </div>
                            <button class="add-cart-btn" style="background:var(--accent-gold); color:white; margin-bottom:8px; width:100%;" onclick="sendTestEmail()"><i class="fa-solid fa-envelope"></i> إرسال اختبار بريد الشكر</button>
                            <button class="add-cart-btn" style="background:var(--success); color:white; margin-bottom:12px; width:100%;" onclick="exportToCSV()"><i class="fa-solid fa-file-excel"></i> تصدير الطلبات Excel</button>

                            <h4 style="margin-top:15px; font-size:0.9rem;">🗑️ إدارة المنتجات والحذف</h4>
                            <div id="adminProductsList" style="margin:10px 0; max-height:120px; overflow-y:auto;"></div>

                            <h4 style="margin-top:15px; font-size:0.9rem;">➕ إضافة منتج جديد</h4>
                            <form onsubmit="saveProduct(event)">
                                <div class="form-group"><label style="color:#aaa;">اسم المنتج</label><input type="text" id="pName" required></div>
                                <div class="form-group"><label style="color:#aaa;">القسم</label>
                                    <select id="pCat">
                                        <option value="best">الأكثر مبيعاً</option>
                                        <option value="cups">الفناجيل والدلات</option>
                                        <option value="plates">القدور والصحون</option>
                                    </select>
                                </div>
                                <div class="form-group"><label style="color:#aaa;">السعر (درهم)</label><input type="number" id="pPrice" required></div>
                                <div class="form-group"><label style="color:#aaa;">الكمية</label><input type="number" id="pStock" value="10" required></div>
                                <div class="form-group"><label style="color:#aaa;">رابط الصورة</label><input type="url" id="pImg" required></div>
                                <button type="submit" class="add-cart-btn" style="background:var(--success); color:white; width:100%;">حفظ المنتج</button>
                            </form>
                        </div>
                    `;
                }

                container.innerHTML = html;
                renderMyOrders();
                if(currentUser.role === 'admin') {
                    renderAdminProductsList();
                }
            }

            document.getElementById('profileModal').style.display = 'flex';
        }

        function renderAdminProductsList() {
            const products = getProducts();
            const container = document.getElementById('adminProductsList');
            container.innerHTML = products.length ? '' : '<small>لا توجد منتجات</small>';
            products.forEach(p => {
                container.innerHTML += `
                    <div class="admin-prod-item">
                        <span>${p.name} (${p.price} د.إ)</span>
                        <button onclick="deleteProduct(${p.id})" style="background:var(--danger); color:white; border:none; padding:4px 8px; border-radius:4px; cursor:pointer;">حذف</button>
                    </div>
                `;
            });
        }

        function deleteProduct(id) {
            let products = getProducts();
            products = products.filter(p => p.id !== id);
            localStorage.setItem('store_products', JSON.stringify(products));
            renderAdminProductsList();
            renderStore();
            alert('تم حذف المنتج بنجاح!');
        }

        function renderMyOrders() {
            const orders = getOrders().filter(o => o.userEmail === currentUser.email);
            const container = document.getElementById('myOrdersList');
            container.innerHTML = orders.length ? '' : '<small>لا توجد طلبات سابقة</small>';
            orders.forEach(o => {
                container.innerHTML += `
                    <div class="card-box">
                        <div><b>رقم الطلب:</b> <span style="color:var(--accent-gold);">${o.orderNum}</span></div>
                        <div><b>المنتجات:</b> ${o.items}</div>
                        <div><b>الإجمالي:</b> ${o.total}</div>
                    </div>`;
            });
        }

        function exportToCSV() {
            const orders = getOrders();
            if(!orders.length) return alert('لا توجد طلبات!');
            let csvContent = "\uFEFFرقم الطلب,العميل,الجوال,المنتجات,المجموع,الدفع,الحالة,التاريخ\n";
            orders.forEach(o => {
                csvContent += `"${o.orderNum}","${o.userName}","${o.userPhone}","${o.items}","${o.total}","${o.payment}","${o.status}","${o.date}"\n`;
            });
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('href', url);
            a.setAttribute('download', 'store_orders.csv');
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        function sendTestEmail() {
            alert(`تم إرسال رسالة الشكر والاختبار التجريبي إلى البريد: ${STORE_EMAIL}\n(تم تنفيذ المحاكاة بنجاح)`);
        }

        function login(e) {
            e.preventDefault();
            const email = document.getElementById('logEmail').value;
            const pass = document.getElementById('logPass').value;

            if(email === ADMIN_EMAIL && pass === ADMIN_PASS) {
                currentUser = { name: "سيف عبدالله", email: ADMIN_EMAIL, role: "admin" };
            } else {
                const users = getUsers();
                const user = users.find(u => u.email === email && u.pass === pass);
                if(!user) return alert('بيانات الدخول غير صحيحة!');
                currentUser = user;
            }

            localStorage.setItem('current_user', JSON.stringify(currentUser));
            openProfileModal();
            renderStore();
        }

        function logout() {
            currentUser = null;
            localStorage.removeItem('current_user');
            openProfileModal();
            renderStore();
        }

        function addToCart(id) {
            const products = getProducts();
            const p = products.find(item => item.id === id);
            if(p.stock <= 0) return alert('عذراً، نفدت الكمية!');
            cart.push(p);
            document.getElementById('cartCount').innerText = cart.length;
            alert('تمت إضافة ' + p.name + ' للسلة');
        }

        function openCart() {
            const container = document.getElementById('cartItems');
            container.innerHTML = '';
            let total = 0;
            cart.forEach((item) => {
                total += Number(item.price);
                container.innerHTML += `<div style="display:flex; justify-content:space-between; margin-bottom:8px; background:#f5efe6; padding:8px; border-radius:6px;"><span>${item.name}</span><b style="color:var(--accent-gold);">${item.price} درهم</b></div>`;
            });
            
            if(discountRate > 0) total = total * (1 - discountRate);

            const minShipping = getFreeShippingMin();
            const progress = Math.min((total / minShipping) * 100, 100);
            document.getElementById('shippingProgress').style.width = progress + '%';
            
            if(total >= minShipping && total > 0) {
                document.getElementById('shippingText').innerHTML = '🎉 مبروك! حصلت على <b style="color:var(--success);">شحن مجاني</b>';
            } else {
                const diff = minShipping - total;
                document.getElementById('shippingText').innerText = `أضف بـ ${diff} درهم إضافية للحصول على شحن مجاني!`;
            }

            document.getElementById('cartTotal').innerText = total + ' درهم';
            document.getElementById('cartModal').style.display = 'flex';
        }

        function applyCoupon() {
            const inputCode = document.getElementById('couponInput').value.toUpperCase().trim();
            const coupons = getCoupons();
            const found = coupons.find(c => c.code === inputCode);
            if (!found || !found.active) return alert('رمز الخصم غير صحيح أو متوقف!');
            discountRate = found.percent / 100;
            alert(`تم تطبيق خصم ${found.percent}% بنجاح!`);
            openCart();
        }

        function checkout() {
            if(!currentUser) {
                closeModal('cartModal');
                alert('يرجى تسجيل الدخول أولاً لإتمام الطلب!');
                openProfileModal();
                return;
            }
            if(!cart.length) return alert('السلة فارغة!');

            let products = getProducts();
            cart.forEach(item => {
                let prod = products.find(p => p.id === item.id);
                if(prod && prod.stock > 0) prod.stock -= 1;
            });
            localStorage.setItem('store_products', JSON.stringify(products));

            const payment = document.getElementById('paymentMethod').value;
            const orders = getOrders();
            const newOrder = {
                id: Date.now(),
                orderNum: generateOrderNumber(),
                userName: currentUser.name,
                userEmail: currentUser.email,
                userPhone: currentUser.phone || 'غير مدخل',
                items: cart.map(c => c.name).join(', '),
                total: document.getElementById('cartTotal').innerText,
                payment: payment,
                status: 'قيد التجهيز ⏳',
                date: new Date().toLocaleDateString('ar-AE')
            };

            orders.push(newOrder);
            localStorage.setItem('store_orders', JSON.stringify(orders));

            alert('تم استلام طلبك برقم ' + newOrder.orderNum + ' بنجاح! وتم إرسال رسالة الشكر للإيميل: ' + STORE_EMAIL);
            cart = [];
            discountRate = 0;
            document.getElementById('cartCount').innerText = '0';
            closeModal('cartModal');
            renderStore();
        }

        function checkoutWhatsapp() {
            if(!cart.length) return alert('السلة فارغة!');
            const itemsList = cart.map(c => c.name).join(', ').trim();
            const total = document.getElementById('cartTotal').innerText;
            const payment = document.getElementById('paymentMethod').value;
            const message = `مرحباً، أرغب في إتمام الطلب التالي:%0A- المنتجات: ${itemsList}%0A- المجموع: ${total}%0A- طريقة الدفع: ${payment}`;
            window.open(`https://wa.me/?text=${message}`, '_blank');
        }

        function saveProduct(e) {
            e.preventDefault();
            const products = getProducts();
            products.push({
                id: Date.now(),
                name: document.getElementById('pName').value,
                category: document.getElementById('pCat').value,
                price: Number(document.getElementById('pPrice').value),
                stock: Number(document.getElementById('pStock').value),
                img: document.getElementById('pImg').value
            });
            localStorage.setItem('store_products', JSON.stringify(products));
            renderStore();
            renderAdminProductsList();
            alert('تم حفظ المنتج بنجاح');
        }

        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        window.onload = function () {
            renderStore();
        };
    </script>
</body>
</html>
